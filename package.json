{
  "name": "dsh-workbuddy2api",
  "displayName": "DSH WorkBuddy2API",
  "description": "用多个 WorkBuddy 账号（网页登录或本机桌面端）组成两个独立账号池（国内版 / 国际版）：加权轮换、会话粘性、冷却熔断、换号重试，并每天自动完成成长任务。",
  "version": "0.4.6",
  "author": "Boiser",
  "copyright": "Copyright (c) 2026 dsh-wb2api",
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "workbuddy",
    "codebuddy",
    "multi-account",
    "account-pool",
    "model-provider"
  ],
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "bin": {
    "dsh-workbuddy2api": "lib/bin.js"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.client.json",
    "check": "npm run typecheck && npm run test && npm run build",
    "testenv": "node testenv/run.mjs",
    "prepack": "npm run build",
    "pack": "npm pack --pack-destination dist-pack",
    "verify-pack": "node testenv/verify-pack.mjs",
    "release:github": "node scripts/publish-release.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.1.5-rc.2 <0.2.0 || >=4.0.2 <5.0.0",
    "@deepseek-ai/dsh-atomic-write": ">=0.1.5-rc.2 <0.2.0",
    "@deepseek-ai/dsh-attachment": ">=0.1.5-rc.2 <0.2.0",
    "@deepseek-ai/dsh-home-paths": ">=0.1.5-rc.2 <0.2.0",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.5-rc.2 <0.2.0",
    "@deepseek-ai/dsh-llm": ">=0.1.5-rc.2 <0.2.0",
    "@deepseek-ai/dsh-llm-pi-ai": ">=0.1.5-rc.2 <0.2.0",
    "@deepseek-ai/dsh-settings": ">=0.1.5-rc.2 <0.2.0",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@earendil-works/pi-ai": ">=0.85.0 <0.86.0",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-atomic-write": "0.1.5-rc.2",
    "@deepseek-ai/dsh-attachment": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.5-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.1.5-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.5-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.2",
    "@deepseek-ai/dsh-llm-pi-ai": "0.1.5-rc.2",
    "@deepseek-ai/dsh-settings": "0.1.5-rc.2",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@earendil-works/pi-ai": "^0.85.1",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.31",
    "react": "^18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FireOpalus/dsh-workbuddy2api.git"
  },
  "bugs": {
    "url": "https://github.com/FireOpalus/dsh-workbuddy2api/issues"
  },
  "homepage": "https://github.com/FireOpalus/dsh-workbuddy2api#readme"
}
